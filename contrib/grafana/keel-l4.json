            "uid": "${datasource}"
          },
          "expr": "sum by (pool) (rate(keel_udp_bytes_out_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} to clients",
