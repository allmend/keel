{
  "uid": "keel-backends",
  "title": "Keel / Backends",
  "description": "Every backend: availability, health, drain, ejection, load and latency.",
  "tags": [
    "keel"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "keel"
      ],
      "asDropdown": true,
      "title": "Keel dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(keel_workers, job)",
          "refId": "job"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(keel_workers{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      },
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\"}, pool)",
          "refId": "pool"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      },
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\"}, backend)",
          "refId": "backend"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Keel restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(keel_start_time_seconds{job=~\"$job\",instance=~\"$instance\"}[2m]) > 0",
        "titleFormat": "Keel restarted",
        "textFormat": "{{instance}}",
        "step": "1m"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "State",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Backends",
      "description": "One row per backend: the worst state any Keel instance shown reports (pick one instance to see its view). Health is empty for pools without a health_check. Requests and p95 over the last 5 minutes.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pool, backend) (keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (pool, backend) (keel_backend_healthy{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pool, backend) (keel_backend_ejected{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (keel_active_connections{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (rate(keel_backend_requests_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[5m]))",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (pool, backend, le) (rate(keel_backend_response_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[5m])))",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "pool": 0,
              "backend": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "backend"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "pool"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Drain"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "active",
                        "color": "green"
                      },
                      "1": {
                        "text": "draining",
                        "color": "orange"
                      },
                      "2": {
                        "text": "removed",
                        "color": "text"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Health"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "unhealthy",
                        "color": "red"
                      },
                      "1": {
                        "text": "healthy",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ejected"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "green"
                      },
                      "1": {
                        "text": "ejected",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Connections"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests / s"
              },
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "state-timeline",
      "title": "Availability over time",
      "description": "Worst state over the Keel instances shown. Green: available. Red: unhealthy or ejected. Orange: draining. Grey: removed.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (pool, backend) (keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}) == 1) * 2 or (max by (pool, backend) (keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}) == 2) + 1 or (min by (pool, backend) (keel_backend_healthy{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}) == 0) + 1 or (max by (pool, backend) (keel_backend_ejected{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}) == 1) or (max by (pool, backend) (keel_backend_drain_state{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}) == 0)",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "available",
                  "color": "green"
                },
                "1": {
                  "text": "unavailable",
                  "color": "red"
                },
                "2": {
                  "text": "draining",
                  "color": "orange"
                },
                "3": {
                  "text": "removed",
                  "color": "text"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "Load and latency",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Active connections",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (keel_active_connections{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"})",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by backend",
      "description": "With equal weights the lines should sit together; weights split traffic in proportion.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (rate(keel_backend_requests_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Backend p95",
      "description": "Backend selected to response complete.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (pool, backend, le) (rate(keel_backend_response_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Backend 5xx",
      "description": "5xx answered by the backend itself.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (rate(keel_backend_requests_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "Failures",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connection errors",
      "description": "A selected backend that could not be reached, or failed mid-request (Keel answered 502).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (rate(keel_backend_connection_errors_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Passive ejections",
      "description": "Ejections after consecutive traffic failures, per 5 minutes.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pool, backend) (increase(keel_backend_ejections_total{job=~\"$job\",instance=~\"$instance\",pool=~\"$pool\",backend=~\"$backend\"}[5m]))",
          "legendFormat": "{{pool}} {{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
